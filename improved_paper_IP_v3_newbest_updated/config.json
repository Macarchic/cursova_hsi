{
  "dataset": "IP",
  "patch_size": 15,
  "pca_components": 150,
  "kernel_size": 9,
  "num_classes": 16,
  "batch_size": 200,
  "data_path": "data",
  "hidden_dim": 64,
  "num_heads": 1,
  "dropout": 0.1,
  "depth": 2,
  "lr": 0.0005,
  "epochs": 100,
  "weight_decay": 0.0001,
  "patience": 20,
  "num_train_per_class": 10,
  "num_val_per_class": 0,
  "seed": 42,
  "use_fps": true,
  "remove_pca_outliers": true,
  "outlier_std": 2.5,
  "use_augmentation": true,
  "use_bidirectional_wkv": true,
  "use_pos_encoding": true,
  "use_se_block": true
}